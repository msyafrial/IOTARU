---
---

<link rel="preload" as="image" href="/images/hero-bg-image-6.webp" />

<div id="home" class="hero bg-section dark-section" style="background-image: url(/images/hero-bg-image-6.webp); background-size: cover; background-position: center; background-repeat: no-repeat;">
  <div class="container">
    <div class="row">
      <div class="col-lg-12">
        <!-- Hero Content Start -->
        <div class="hero-content">
          <!-- Section Title Start -->
          <div class="section-title">
            <h1 class="text-anime-style-3" data-cursor="-opaque">Integrated IoT Solutions for Smart Security & Monitoring</h1>
            <p class="wow fadeInUp" data-wow-delay="0.2s" style="margin-top: 15px; color: rgba(255,255,255,0.8); font-size: 1.1em;">IOTARU Teknologi Nusantara powers reliable, secure, and scalable IoT solutions, turning real-time data into smarter security, monitoring, and automation.</p>
          </div>
          <!-- Section Title End -->

          <!-- Hero Feature List Start -->
          <div class="hero-feature-list wow fadeInUp" data-wow-delay="0.2s">
            <div class="hero-feature-item">
              <div class="icon-box"><img src="/images/icon-hero-feature-1.svg" alt=""></div>
              <div class="hero-feature-item-content"><p>End-to-End IoT Solution</p></div>
            </div>
            <div class="hero-feature-item">
              <div class="icon-box"><img src="/images/icon-hero-feature-2.svg" alt=""></div>
              <div class="hero-feature-item-content"><p>Security-First Architecture</p></div>
            </div>
            <div class="hero-feature-item">
              <div class="icon-box"><img src="/images/icon-hero-feature-3.svg" alt=""></div>
              <div class="hero-feature-item-content"><p>Custom & Scalable</p></div>
            </div>
            <div class="hero-feature-item">
              <div class="icon-box"><img src="/images/icon-hero-feature-2.svg" alt=""></div>
              <div class="hero-feature-item-content"><p>Local Expertise</p></div>
            </div>
          </div>
          <!-- Hero Feature List End -->
        </div>
        <!-- Hero Content End -->

        <!-- Hero Image Start -->
        <div class="hero-image">
          <figure><img src="/images/hero.jpg" alt="Hero Image" loading="eager" fetchpriority="high" decoding="sync" /></figure>
        </div>
        <!-- Hero Image End -->
      </div>
    </div>
  </div>
</div>
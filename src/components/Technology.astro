---
import { Image } from 'astro:assets';
import stImg from '../assets/stack/st.png';
import espImg from '../assets/stack/esp32.png';
import freertosImg from '../assets/stack/freeRTOS.webp';
import mqttImg from '../assets/stack/mqtt.png';
import microservicesImg from '../assets/stack/microservices.png';
import otaImg from '../assets/stack/ota.webp';
import nrfImg from '../assets/stack/nrf.svg';
import loraImg from '../assets/stack/lora.png';
import modbusImg from '../assets/stack/modbus.png';
import bleImg from '../assets/stack/ble.png';
import ebyteImg from '../assets/stack/ebyte.png';
import simcomImg from '../assets/stack/simcom.png';
---

<div class="technology-section">
  <div class="container">
    <div class="row section-row">
      <div class="col-lg-12">
        <div class="section-title section-title-center">
          <span class="section-badge">Seamless Integrations</span>
          <h3 class="wow fadeInUp">TECHNOLOGY</h3>
          <h2 class="text-anime-style-3" data-cursor="-opaque">
            Technology Stack
          </h2>
          <p class="wow fadeInUp" data-wow-delay="0.1s">
            IOTARU Teknologi Nusantara is built using trusted, industry-proven technologies to ensure reliability, security, and long-term scalability.
          </p>
        </div>
      </div>
    </div>
  </div>

  <div class="tech-container">
    <div class="tech-grid">
      <div class="tech-card wow fadeInUp">
        <div class="tech-card-badge">Hardware</div>
        <div class="tech-card-icon">
          <Image src={stImg} alt="STM32" />
        </div>
        <h3 class="tech-card-name">STM32 Series</h3>
        <p class="tech-card-desc">High-performance industrial microcontrollers for reliable systems</p>
      </div>

      <div class="tech-card wow fadeInUp" data-wow-delay="0.1s">
        <div class="tech-card-badge">Hardware</div>
        <div class="tech-card-icon">
          <Image src={espImg} alt="ESP32" />
        </div>
        <h3 class="tech-card-name">ESP32</h3>
        <p class="tech-card-desc">High-performance edge device for reliable IoT operations</p>
      </div>

      <div class="tech-card wow fadeInUp" data-wow-delay="0.2s">
        <div class="tech-card-badge">Software</div>
        <div class="tech-card-icon">
          <Image src={freertosImg} alt="FreeRTOS" />
        </div>
        <h3 class="tech-card-name">FreeRTOS</h3>
        <p class="tech-card-desc">Real-time operating system for stable multitasking control</p>
      </div>

      <div class="tech-card wow fadeInUp" data-wow-delay="0.3s">
        <div class="tech-card-badge">Protocol</div>
        <div class="tech-card-icon">
          <Image src={mqttImg} alt="MQTT" />
        </div>
        <h3 class="tech-card-name">MQTT Protocol</h3>
        <p class="tech-card-desc">Lightweight and secure data communication for IoT systems</p>
      </div>

      <div class="tech-card wow fadeInUp" data-wow-delay="0.4s">
        <div class="tech-card-badge">Software</div>
        <div class="tech-card-icon">
          <Image src={microservicesImg} alt="Backend Services" />
        </div>
        <h3 class="tech-card-name">Backend Services</h3>
        <p class="tech-card-desc">Scalable data processing and device management services</p>
      </div>

      <div class="tech-card wow fadeInUp" data-wow-delay="0.5s">
        <div class="tech-card-badge">Security</div>
        <div class="tech-card-icon">
          <Image src={otaImg} alt="Security" />
        </div>
        <h3 class="tech-card-name">Security & OTA</h3>
        <p class="tech-card-desc">Encrypted communication and secure firmware updates</p>
      </div>

      <div class="tech-card wow fadeInUp" data-wow-delay="0.6s">
        <div class="tech-card-badge">Hardware</div>
        <div class="tech-card-icon">
          <Image src={nrfImg} alt="Nordic nRF" />
        </div>
        <h3 class="tech-card-name">Nordic nRF Series</h3>
        <p class="tech-card-desc">Low-power wireless SoC for reliable BLE and RF-based IoT communication</p>
      </div>

      <div class="tech-card wow fadeInUp" data-wow-delay="0.7s">
        <div class="tech-card-badge">Connectivity</div>
        <div class="tech-card-icon">
          <Image src={loraImg} alt="LoRa" />
        </div>
        <h3 class="tech-card-name">LoRa / LoRaWAN</h3>
        <p class="tech-card-desc">Long-range, low-power connectivity for wide-area IoT deployments</p>
      </div>

      <div class="tech-card wow fadeInUp" data-wow-delay="0.8s">
        <div class="tech-card-badge">Protocol</div>
        <div class="tech-card-icon">
          <Image src={modbusImg} alt="Modbus" />
        </div>
        <h3 class="tech-card-name">Modbus RTU / TCP</h3>
        <p class="tech-card-desc">Industrial protocol for seamless integration with field devices</p>
      </div>

      <div class="tech-card wow fadeInUp" data-wow-delay="0.9s">
        <div class="tech-card-badge">Connectivity</div>
        <div class="tech-card-icon">
          <Image src={bleImg} alt="Bluetooth Low Energy" />
        </div>
        <h3 class="tech-card-name">Bluetooth Low Energy</h3>
        <p class="tech-card-desc">Secure short-range wireless communication for device provisioning and control</p>
      </div>

      <div class="tech-card wow fadeInUp" data-wow-delay="1.0s">
        <div class="tech-card-badge">Connectivity</div>
        <div class="tech-card-icon">
          <Image src={ebyteImg} alt="Ebyte" />
        </div>
        <h3 class="tech-card-name">Ebyte Modules</h3>
        <p class="tech-card-desc">Wireless communication modules including LoRa, WiFi, BLE, and ZigBee for industrial IoT</p>
      </div>

      <div class="tech-card wow fadeInUp" data-wow-delay="1.1s">
        <div class="tech-card-badge">Connectivity</div>
        <div class="tech-card-icon">
          <Image src={simcomImg} alt="SIMCom" />
        </div>
        <h3 class="tech-card-name">SIMCom Modules</h3>
        <p class="tech-card-desc">Cellular wireless modules supporting 5G, 4G, LPWA, and GNSS for global IoT connectivity</p>
      </div>
    </div>
  </div>

  <div class="container">
    <div class="row">
      <div class="col-lg-12">
        <div class="integration-counter-list wow fadeInUp" data-wow-delay="0.2s">
          <div class="integration-counter-item">
            <div class="integration-counter-no">
              <h2><span class="counter">99</span>%</h2>
            </div>
            <div class="integration-counter-content">
              <p>System uptime and communication reliability</p>
            </div>
          </div>

          <div class="integration-counter-item">
            <div class="integration-counter-no">
              <h2>24/7</h2>
            </div>
            <div class="integration-counter-content">
              <p>Continuous monitoring and real-time alerts</p>
            </div>
          </div>

          <div class="integration-counter-item">
            <div class="integration-counter-no">
              <h2>OTA</h2>
            </div>
            <div class="integration-counter-content">
              <p>Remote firmware updates without system downtime</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .technology-section {
    padding: 100px 0;
    background: #f8f9fa;
  }

  .tech-container {
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 15px;
  }

  .section-badge {
    display: inline-block;
    padding: 6px 18px;
    background: rgba(255, 152, 0, 0.1);
    color: var(--accent-color);
    border-radius: 100px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    margin-bottom: 20px;
  }

  .tech-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    margin-top: 50px;
  }

  .tech-card {
    position: relative;
    background: var(--white-color);
    border-radius: 16px;
    padding: 30px 24px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
    border: 1px solid var(--divider-color);
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
  }

  .tech-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.1);
    border-color: var(--accent-color);
  }

  .tech-card-badge {
    position: absolute;
    top: 16px;
    right: 16px;
    padding: 4px 12px;
    background: #f0f2f5;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 600;
    color: var(--text-color);
    opacity: 0.7;
  }

  .tech-card-icon {
    height: 50px;
    display: flex;
    align-items: center;
  }

  .tech-card-icon img {
    max-height: 50px;
    max-width: 120px;
    object-fit: contain;
  }

  .tech-card-name {
    font-size: 18px;
    font-weight: 600;
    color: var(--primary-color);
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid var(--divider-color);
  }

  .tech-card-desc {
    font-size: 14px;
    color: var(--text-color);
    line-height: 1.7;
    margin-top: 10px;
    opacity: 0.8;
    flex: 1;
    overflow: hidden;
  }

  @media (max-width: 1199px) {
    .tech-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 991px) {
    .tech-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }
  }

  @media (max-width: 575px) {
    .technology-section {
      padding: 60px 0;
    }

    .tech-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .tech-card {
      padding: 24px 20px;
    }
  }
</style>

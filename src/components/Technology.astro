---
import stImg from '../assets/stack/st.png';
import espImg from '../assets/stack/esp32.png';
import freertosImg from '../assets/stack/freeRTOS.webp';
import mqttImg from '../assets/stack/mqtt.png';
import microservicesImg from '../assets/stack/microservices.png';
import otaImg from '../assets/stack/ota.webp';
import nrfImg from '../assets/stack/nrf.svg';
import loraImg from '../assets/stack/lora.png';
import modbusImg from '../assets/stack/modbus.png';
import bleImg from '../assets/stack/ble.png';
import ebyteImg from '../assets/stack/ebyte.png';
import simcomImg from '../assets/stack/simcom.png';

const techStack = [
  {
    badge: 'Hardware',
    img: stImg,
    alt: 'STM32',
    name: 'STM32 Series',
    desc: 'High-performance industrial microcontrollers for reliable systems',
    delay: '0s',
  },
  {
    badge: 'Hardware',
    img: espImg,
    alt: 'ESP32',
    name: 'ESP32',
    desc: 'High-performance edge device for reliable IoT operations',
    delay: '0.1s',
  },
  {
    badge: 'Software',
    img: freertosImg,
    alt: 'FreeRTOS',
    name: 'FreeRTOS',
    desc: 'Real-time operating system for stable multitasking control',
    delay: '0.2s',
  },
  {
    badge: 'Protocol',
    img: mqttImg,
    alt: 'MQTT',
    name: 'MQTT Protocol',
    desc: 'Lightweight and secure data communication for IoT systems',
    delay: '0.3s',
  },
  {
    badge: 'Software',
    img: microservicesImg,
    alt: 'Backend Services',
    name: 'Backend Services',
    desc: 'Scalable data processing and device management services',
    delay: '0.4s',
  },
  {
    badge: 'Security',
    img: otaImg,
    alt: 'Security',
    name: 'Security & OTA',
    desc: 'Encrypted communication and secure firmware updates',
    delay: '0.5s',
  },
  {
    badge: 'Hardware',
    img: nrfImg,
    alt: 'Nordic nRF',
    name: 'Nordic nRF Series',
    desc: 'Low-power wireless SoC for reliable BLE and RF-based IoT communication',
    delay: '0.6s',
  },
  {
    badge: 'Connectivity',
    img: loraImg,
    alt: 'LoRa',
    name: 'LoRa / LoRaWAN',
    desc: 'Long-range, low-power connectivity for wide-area IoT deployments',
    delay: '0.7s',
  },
  {
    badge: 'Protocol',
    img: modbusImg,
    alt: 'Modbus',
    name: 'Modbus RTU / TCP',
    desc: 'Industrial protocol for seamless integration with field devices',
    delay: '0.8s',
  },
  {
    badge: 'Connectivity',
    img: bleImg,
    alt: 'Bluetooth Low Energy',
    name: 'Bluetooth Low Energy',
    desc: 'Secure short-range wireless communication for device provisioning and control',
    delay: '0.9s',
  },
  {
    badge: 'Connectivity',
    img: ebyteImg,
    alt: 'Ebyte',
    name: 'Ebyte Modules',
    desc: 'Wireless communication modules including LoRa, WiFi, BLE, and ZigBee for industrial IoT',
    delay: '1.0s',
  },
  {
    badge: 'Connectivity',
    img: simcomImg,
    alt: 'SIMCom',
    name: 'SIMCom Modules',
    desc: 'Cellular wireless modules supporting 5G, 4G, LPWA, and GNSS for global IoT connectivity',
    delay: '1.1s',
  },
];
---

<div class="technology-section">
  <div class="container">
    <div class="row section-row">
      <div class="col-lg-12">
        <div class="section-title section-title-center">
          <span class="section-badge">Seamless Integrations</span>
          <h3 class="wow fadeInUp">TECHNOLOGY</h3>
          <h2 class="text-anime-style-3" data-cursor="-opaque">
            Technology Stack
          </h2>
          <p class="wow fadeInUp" data-wow-delay="0.1s">
            IOTARU Teknologi Nusantara is built using trusted, industry-proven technologies to ensure reliability, security, and long-term scalability.
          </p>
        </div>
      </div>
    </div>
  </div>

  <div class="tech-container">
    <div class="tech-grid">
      {techStack.map((tech) => (
        <div class="tech-card wow fadeInUp" data-wow-delay={tech.delay}>
          <div class="tech-card-badge">{tech.badge}</div>
          <div class="tech-card-icon">
            <img
              src={tech.img.src}
              alt={tech.alt}
              width={tech.img.width}
              height={tech.img.height}
              loading="lazy"
              decoding="async"
            />
          </div>
          <h3 class="tech-card-name">{tech.name}</h3>
          <p class="tech-card-desc">{tech.desc}</p>
        </div>
      ))}
    </div>
  </div>

  <div class="container">
    <div class="row">
      <div class="col-lg-12">
        <div class="integration-counter-list wow fadeInUp" data-wow-delay="0.2s">
          <div class="integration-counter-item">
            <div class="integration-counter-no">
              <h2><span class="counter">99</span>%</h2>
            </div>
            <div class="integration-counter-content">
              <p>System uptime and communication reliability</p>
            </div>
          </div>

          <div class="integration-counter-item">
            <div class="integration-counter-no">
              <h2>24/7</h2>
            </div>
            <div class="integration-counter-content">
              <p>Continuous monitoring and real-time alerts</p>
            </div>
          </div>

          <div class="integration-counter-item">
            <div class="integration-counter-no">
              <h2>OTA</h2>
            </div>
            <div class="integration-counter-content">
              <p>Remote firmware updates without system downtime</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .technology-section {
    padding: 100px 0;
    background: #f8f9fa;
  }

  .tech-container {
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 15px;
  }

  .section-badge {
    display: inline-block;
    padding: 6px 18px;
    background: rgba(255, 152, 0, 0.1);
    color: var(--accent-color);
    border-radius: 100px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    margin-bottom: 20px;
  }

  .tech-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    margin-top: 50px;
  }

  .tech-card {
    position: relative;
    background: var(--white-color);
    border-radius: 16px;
    padding: 30px 24px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
    border: 1px solid var(--divider-color);
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
  }

  .tech-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.1);
    border-color: var(--accent-color);
  }

  .tech-card-badge {
    position: absolute;
    top: 16px;
    right: 16px;
    padding: 4px 12px;
    background: #f0f2f5;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 600;
    color: var(--text-color);
    opacity: 0.7;
  }

  .tech-card-icon {
    height: 50px;
    display: flex;
    align-items: center;
  }

  .tech-card-icon img {
    max-height: 50px;
    max-width: 120px;
    object-fit: contain;
  }

  .tech-card-name {
    font-size: 18px;
    font-weight: 600;
    color: var(--primary-color);
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid var(--divider-color);
  }

  .tech-card-desc {
    font-size: 14px;
    color: var(--text-color);
    line-height: 1.7;
    margin-top: 10px;
    opacity: 0.8;
    flex: 1;
    overflow: hidden;
  }

  @media (max-width: 1199px) {
    .tech-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 991px) {
    .tech-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }
  }

  @media (max-width: 575px) {
    .technology-section {
      padding: 60px 0;
    }

    .tech-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .tech-card {
      padding: 24px 20px;
    }
  }
</style>

---
interface Props {
  currentPage: number;
  totalPages: number;
  basePath: string;
  searchParams?: string;
}

const { currentPage, totalPages, basePath, searchParams } = Astro.props;

function getPageNumbers(): (number | string)[] {
  if (totalPages <= 7) {
    return Array.from({ length: totalPages }, (_, i) => i + 1);
  }

  const pages: (number | string)[] = [];
  const last = totalPages;

  if (currentPage <= 3) {
    pages.push(1, 2, 3, 4, '...', last);
  } else if (currentPage >= last - 2) {
    pages.push(1, '...', last - 3, last - 2, last - 1, last);
  } else {
    pages.push(1, '...', currentPage - 1, currentPage, currentPage + 1, '...', last);
  }

  return pages;
}

function buildHref(pageNum: number) {
  const params = new URLSearchParams(searchParams || '');
  if (pageNum === 1) {
    params.delete('page');
    const qs = params.toString();
    return qs ? `${basePath}?${qs}` : basePath;
  }
  params.set('page', String(pageNum));
  return `${basePath}?${params.toString()}`;
}

const pages = getPageNumbers();
---

<div class="pagination-wrapper">
  <nav class="pagination" aria-label="Product pagination">
    <a
      href={currentPage === 1 ? undefined : buildHref(currentPage - 1)}
      class={`pagination-btn pagination-prev ${currentPage === 1 ? 'disabled' : ''}`}
      aria-disabled={currentPage === 1}
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </a>

    <div class="pagination-numbers">
      {pages.map((page) => {
        if (page === '...') {
          return <span class="pagination-ellipsis">&hellip;</span>;
        }
        return (
          <a
            href={buildHref(page)}
            class={`pagination-num ${page === currentPage ? 'active' : ''}`}
            aria-current={page === currentPage ? 'page' : undefined}
          >
            {page}
          </a>
        );
      })}
    </div>

    <a
      href={currentPage === totalPages ? undefined : buildHref(currentPage + 1)}
      class={`pagination-btn pagination-next ${currentPage === totalPages ? 'disabled' : ''}`}
      aria-disabled={currentPage === totalPages}
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </a>
  </nav>
</div>

<style>
  .pagination-wrapper {
    display: flex;
    justify-content: center;
    margin-top: 50px;
    padding-top: 40px;
    border-top: 1px solid var(--divider-color);
  }

  .pagination {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .pagination-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    background: var(--white-color);
    border: 1.5px solid var(--divider-color);
    border-radius: 12px;
    color: var(--text-color);
    text-decoration: none;
    transition: all 0.25s ease;
  }

  .pagination-btn:hover:not(.disabled) {
    border-color: var(--accent-color);
    color: var(--accent-color);
    background: rgba(255, 152, 0, 0.04);
  }

  .pagination-btn.disabled {
    opacity: 0.3;
    pointer-events: none;
  }

  .pagination-numbers {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .pagination-num {
    min-width: 42px;
    height: 42px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 4px;
    background: var(--white-color);
    border: 1.5px solid var(--divider-color);
    border-radius: 12px;
    font-size: 14px;
    font-weight: 600;
    color: var(--text-color);
    text-decoration: none;
    transition: all 0.25s ease;
  }

  .pagination-num:hover {
    border-color: var(--accent-color);
    color: var(--accent-color);
    background: rgba(255, 152, 0, 0.04);
  }

  .pagination-num.active {
    background: var(--accent-color);
    border-color: var(--accent-color);
    color: var(--primary-color);
    box-shadow: 0 2px 10px rgba(255, 152, 0, 0.3);
    transform: scale(1.05);
  }

  .pagination-ellipsis {
    min-width: 32px;
    height: 42px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    font-weight: 600;
    color: var(--text-color);
    opacity: 0.35;
    user-select: none;
  }

  @media (max-width: 575px) {
    .pagination {
      gap: 6px;
    }

    .pagination-btn {
      width: 44px;
      height: 44px;
      border-radius: 12px;
    }

    .pagination-num {
      min-width: 44px;
      height: 44px;
      font-size: 13px;
      border-radius: 12px;
    }

    .pagination-ellipsis {
      min-width: 32px;
      height: 44px;
    }
  }
</style>

---
interface Props {
  title: string;
  description: string;
  category: string;
  image: string;
  href: string;
  [key: string]: any;
}

const { title, description, category, image, href, class: className, ...rest } = Astro.props;
const classes = ['product-card-item', className].filter(Boolean).join(' ');
---

<a href={href} class={classes} {...rest}>
  <div class="product-card-image">
    <img src={image || '/images/products/hero.jpg'} alt={title} />
    <span class="product-card-category">{category}</span>
  </div>
  <div class="product-card-content">
    <h3>{title}</h3>
    <p>{description}</p>
    <span class="product-card-btn">
      View Details
      <i class="fa-solid fa-arrow-right"></i>
    </span>
  </div>
</a>

<style>
  .product-card-item {
    display: block;
    background: var(--white-color);
    border-radius: 20px;
    overflow: hidden;
    text-decoration: none;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    border: 1px solid var(--divider-color);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
    height: 100%;
  }

  .product-card-item:hover {
    transform: translateY(-8px);
    border-color: var(--accent-color);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.12);
  }

  .product-card-image {
    position: relative;
    aspect-ratio: 16 / 11;
    overflow: hidden;
    background: #f0f2f5;
  }

  .product-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .product-card-item:hover .product-card-image img {
    transform: scale(1.06);
  }

  .product-card-category {
    position: absolute;
    top: 14px;
    left: 14px;
    padding: 6px 14px;
    background: var(--accent-color);
    border-radius: 100px;
    font-size: 11px;
    font-weight: 600;
    color: var(--primary-color);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .product-card-content {
    padding: 24px;
  }

  .product-card-content h3 {
    color: var(--primary-color);
    font-size: 18px;
    font-weight: 600;
    margin-bottom: 10px;
    line-height: 1.3;
    transition: color 0.3s ease;
  }

  .product-card-item:hover .product-card-content h3 {
    color: var(--accent-color);
  }

  .product-card-content p {
    color: var(--text-color);
    font-size: 14px;
    line-height: 1.7;
    margin-bottom: 18px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .product-card-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--accent-color);
    font-size: 14px;
    font-weight: 600;
    transition: gap 0.3s ease;
  }

  .product-card-btn i {
    transition: transform 0.3s ease;
  }

  .product-card-item:hover .product-card-btn {
    gap: 12px;
  }

  .product-card-item:hover .product-card-btn i {
    transform: translateX(3px);
  }
</style>

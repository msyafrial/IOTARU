<div class="preloader" id="preloader">
  <div class="loading-container">
    <div class="loading"></div>
  </div>
</div>

<script>
  (function () {
    var preloader = document.getElementById('preloader');
    if (!preloader) return;

    var dismissed = false;

    function dismissPreloader() {
      if (dismissed) return;
      dismissed = true;

      preloader.style.opacity = '0';
      preloader.style.visibility = 'hidden';
      setTimeout(function () {
        preloader.style.display = 'none';
        window.dispatchEvent(new Event('preloader:done'));
      }, 300);
    }

    // Hard fallback: dismiss after max 5s no matter what
    var hardTimeout = setTimeout(dismissPreloader, 5000);

    // Track both critical images: bg + hero.jpg
    var BG_URL   = '/images/hero-bg-image-6.webp';
    var HERO_URL = '/images/hero.jpg';

    var bgLoaded   = false;
    var heroLoaded = false;

    function checkBothReady() {
      if (bgLoaded && heroLoaded) {
        clearTimeout(hardTimeout);
        // Two rAF to ensure the browser has actually painted the frame
        requestAnimationFrame(function () {
          requestAnimationFrame(dismissPreloader);
        });
      }
    }

    function loadImage(url, onDone) {
      var img = new Image();
      img.onload  = onDone;
      img.onerror = onDone; // even on error, don't block preloader
      img.src = url;
      // If already cached by the browser, onload may fire synchronously
      if (img.complete) onDone();
    }

    loadImage(BG_URL, function () {
      bgLoaded = true;
      checkBothReady();
    });

    loadImage(HERO_URL, function () {
      heroLoaded = true;
      checkBothReady();
    });
  })();
</script>

<style>
  .preloader {
    position: fixed;
    inset: 0;
    z-index: 9999;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }
</style>

---
---

<div class="preloader" id="preloader" transition:persist="preloader">
  <div class="loading-container">
    <div class="loading"></div>
  </div>
</div>

<script>
  (function () {
    const preloader: HTMLElement | null = document.getElementById('preloader');
    if (preloader === null) return;

    const el = preloader as HTMLElement;
    let dismissed = false;

    function dismissPreloader() {
      if (dismissed) return;
      dismissed = true;

      el.style.opacity = '0';
      el.style.visibility = 'hidden';
      setTimeout(function () {
        el.style.display = 'none';
        (window as any).__preloaderDone = true;
        window.dispatchEvent(new Event('preloader:done'));
      }, 300);
    }

    // Hard fallback: dismiss after max 5s no matter what
    var hardTimeout = setTimeout(dismissPreloader, 5000);

    // Track both critical images: bg + hero.jpg
    var BG_URL   = '/images/hero-bg-image-6.webp';
    var HERO_URL = '/images/hero.jpg';

    var bgLoaded   = false;
    var heroLoaded = false;

    function checkBothReady() {
      if (bgLoaded && heroLoaded) {
        clearTimeout(hardTimeout);
        // Two rAF to ensure the browser has actually painted the frame
        requestAnimationFrame(function () {
          requestAnimationFrame(dismissPreloader);
        });
      }
    }

    function loadImage(url: string, onDone: () => void) {
      var img = new Image();
      img.onload  = onDone;
      img.onerror = onDone; // even on error, don't block preloader
      img.src = url;
      // If already cached by the browser, onload may fire synchronously
      if (img.complete) onDone();
    }

    loadImage(BG_URL, function () {
      bgLoaded = true;
      checkBothReady();
    });

    loadImage(HERO_URL, function () {
      heroLoaded = true;
      checkBothReady();
    });
  })();

  // View Transitions: preloader di-persist antar halaman, tapi kalau swap
  // terjadi sebelum preloader sempat di-dismiss (mis. navigasi cepat),
  // pastikan dia disembunyikan paksa agar situs tidak tertutup preloader.
  document.addEventListener('astro:after-swap', function () {
    const pre = document.getElementById('preloader');
    if (pre && pre.style.display !== 'none') {
      pre.style.display = 'none';
      (window as any).__preloaderDone = true;
    }
  });
</script>

<style>
  .preloader {
    position: fixed;
    inset: 0;
    z-index: 9999;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }
</style>

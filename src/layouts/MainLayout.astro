---
import "../styles/global.css";
import criticalCSS from "../styles/critical.css?inline";

const {
  title,
  description = "IoT-driven automation and monitoring solutions for industries",
  image,
} = Astro.props;
const canonicalURL = new URL(
  Astro.url.pathname,
  Astro.site || "https://iotaru.com",
);
const socialImage = image
  ? new URL(image, Astro.site || "https://iotaru.com")
  : new URL("/images/iotaru-og.png", Astro.site || "https://iotaru.com");
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="IoT, automation, monitoring, SCADA, sensor, industrial"
    />
    <meta name="author" content="IOTARU" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Social -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={`IOTARU - ${title}`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:site_name" content="IOTARU" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`IOTARU - ${title}`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    <title>IOTARU - {title}</title>
    <link rel="shortcut icon" type="image/x-icon" href="/favicon.svg" />

    <!-- Preload critical above-the-fold images -->
    <link
      rel="preload"
      as="image"
      href="/images/hero-bg-image-6.webp"
      fetchpriority="high"
    />
    <link
      rel="preload"
      as="image"
      href="/images/hero.jpg"
      fetchpriority="high"
    />
    
     <link
      rel="preload"
      as="image"
      href="/images/logo.png"
      fetchpriority="high"
    />

    <!-- Critical CSS - inlined for fast first paint -->
    <style set:html={criticalCSS}></style>

    <!-- Self-hosted fonts (no external CDN dependency) -->
    <link href="/css/fonts.css" rel="stylesheet" />

    <!-- Non-critical CSS - loaded async -->
    <link
      href="/css/bootstrap.min.css"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <link
      href="/css/custom.css"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <link
      href="/css/swiper-bundle.min.css"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <link
      href="/css/animate.css"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <link
      href="/css/font-awesome.min.css"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <link
      href="/css/mousecursor.css"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
  </head>

  <body>
    <main>
      <slot />
    </main>

    <!-- Critical scripts: jQuery + Bootstrap (needed for navbar/layout on first view) -->
    <script src="/js/jquery-3.7.1.min.js" defer></script>
    <script src="/js/bootstrap.min.js" defer></script>
    <script src= "/js/wow.min.js" defer></script>


    <!-- Non-critical scripts: loaded after window load to not block first paint -->
    <script is:inline>
      (function () {
        var nonCritical = [
          "/js/gsap.min.js",
          "/js/ScrollTrigger.min.js",
          "/js/SplitText.min.js",
          "/js/swiper-bundle.min.js",
         
          "/js/SmoothScroll.js",
          "/js/magiccursor.js",
          "/js/jquery.waypoints.min.js",
          "/js/jquery.counterup.min.js",
          "/js/function.js",
        ];

        function loadScriptsSequentially(scripts, index) {
          if (index >= scripts.length) return;
          var s = document.createElement("script");
          s.src = scripts[index];
          s.onload = function () {
            loadScriptsSequentially(scripts, index + 1);
          };
          document.body.appendChild(s);
        }

        // Wait until preloader is done (or window load) before loading heavy scripts
        function startLoad() {
          loadScriptsSequentially(nonCritical, 0);
        }

        if (window.__preloaderDone) {
          startLoad();
        } else {
          window.addEventListener("preloader:done", startLoad, { once: true });
          // Safety fallback: start loading after window load regardless
          window.addEventListener(
            "load",
            function () {
              setTimeout(startLoad, 100);
            },
            { once: true },
          );
        }
      })();
    </script>
  </body>
</html>

---
import { getCollection, render } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');

  return posts.map((post) => ({
    params: {
      slug: post.id,
    },
    props: {
      post,
    },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const allPosts = await getCollection('blog');
const relatedPosts = allPosts.filter(p => p.id !== post.id).slice(0, 2);

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}

const postImage = post.data.image
  ? typeof post.data.image === 'string'
    ? post.data.image
    : (post.data.image as any)?.src || '/images/hero.jpg'
  : '/images/hero.jpg';

const blogSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "@id": `https://iotaru.com/blog/${post.id}/#article`,
  headline: post.data.title,
  description: post.data.description,
  image: new URL(postImage, Astro.site || "https://iotaru.com").toString(),
  datePublished: post.data.pubDate ? new Date(post.data.pubDate).toISOString() : undefined,
  author: {
    "@type": "Organization",
    name: "IOTARU",
    url: "https://iotaru.com",
  },
  publisher: {
    "@id": "https://iotaru.com/#organization",
  },
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": `https://iotaru.com/blog/${post.id}/`,
  },
};
---

<MainLayout
  title={post.data.title}
  description={post.data.description}
  image={postImage}
  type="article"
  schema={blogSchema}
>
  <Navbar />

  <!-- Hero Section -->
  <section class="hero hero-product bg-section dark-section" style="background-image: url(/images/hero-bg-image-6.webp); background-size: cover; background-position: center; background-repeat: no-repeat;">
    <div class="container">
      <div class="row">
        <div class="col-lg-12">
          <div class="section-title section-title-center">
            {post.data.tags && post.data.tags.length > 0 && (
              <div class="blog-hero-tags wow fadeInUp">
                {post.data.tags.map(tag => (
                  <span class="blog-hero-tag">{tag}</span>
                ))}
              </div>
            )}
            <h1 class="text-anime-style-3" data-cursor="-opaque">{post.data.title}</h1>
            <p class="wow fadeInUp" data-wow-delay="0.2s" style="margin-top: 10px; color: rgba(255,255,255,0.8); font-size: 1em;">
              {post.data.description}
            </p>
            {post.data.pubDate && (
              <p class="wow fadeInUp" data-wow-delay="0.3s" style="margin-top: 12px; color: rgba(255,255,255,0.5); font-size: 0.85em;">
                {formatDate(new Date(post.data.pubDate))}
              </p>
            )}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Blog Content -->
  <section class="key-features bg-section">
    <div class="container">
      <div class="row">
        <div class="col-lg-8 mx-auto">
          <div class="blog-content wow fadeInUp" data-wow-delay="0.2s">
            <Content />
          </div>
        </div>
      </div>

      {relatedPosts.length > 0 && (
        <div class="row section-row" style="margin-top: 60px;">
          <div class="col-lg-12">
            <div class="section-title section-title-center">
              <h3 class="wow fadeInUp">Related Posts</h3>
              <h2 class="text-anime-style-3" data-cursor="-opaque">Read more from our blog</h2>
            </div>
          </div>
        </div>
      )}

      {relatedPosts.length > 0 && (
        <div class="row">
          {relatedPosts.map((related, i) => (
            <div class="col-lg-6 wow fadeInUp" data-wow-delay={`${i * 0.15}s`}>
              <a href={`/blog/${related.id}`} class="blog-card">
                <div class="blog-card-meta">
                  {related.data.pubDate && (
                    <span class="blog-card-date">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                      {formatDate(new Date(related.data.pubDate))}
                    </span>
                  )}
                </div>
                <h3 class="blog-card-title">{related.data.title}</h3>
                <p class="blog-card-desc">{related.data.description}</p>
                <span class="blog-card-btn">
                  Read More
                  <i class="fa-solid fa-arrow-right"></i>
                </span>
              </a>
            </div>
          ))}
        </div>
      )}
    </div>
  </section>

  <Footer />
</MainLayout>

<style>
  .hero.hero-product h1,
  .hero.hero-product h2 {
    font-size: 48px;
    font-weight: 600;
    line-height: 1.2em;
    margin-bottom: 0;
  }

  .blog-hero-tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
    margin-bottom: 12px;
  }

  .blog-hero-tag {
    padding: 4px 12px;
    background: rgba(255, 152, 0, 0.2);
    border: 1px solid rgba(255, 152, 0, 0.3);
    border-radius: 100px;
    font-size: 11px;
    font-weight: 600;
    color: var(--accent-color);
    letter-spacing: 0.3px;
  }

  .blog-content {
    font-size: 16px;
    line-height: 1.8;
    color: var(--text-color);
  }

  .blog-content :global(h1) {
    color: var(--primary-color);
    font-size: 32px;
    font-weight: 700;
    margin-bottom: 16px;
    margin-top: 40px;
  }

  .blog-content :global(h2) {
    color: var(--primary-color);
    font-size: 24px;
    font-weight: 600;
    margin-top: 36px;
    margin-bottom: 14px;
  }

  .blog-content :global(h3) {
    color: var(--primary-color);
    font-size: 20px;
    font-weight: 600;
    margin-top: 28px;
    margin-bottom: 12px;
  }

  .blog-content :global(p) {
    margin-bottom: 16px;
    color: var(--text-color);
  }

  .blog-content :global(ul),
  .blog-content :global(ol) {
    margin-bottom: 20px;
    padding-left: 24px;
  }

  .blog-content :global(li) {
    margin-bottom: 8px;
    color: var(--text-color);
  }

  .blog-content :global(strong) {
    color: var(--primary-color);
    font-weight: 600;
  }

  .blog-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 24px;
    font-size: 14px;
  }

  .blog-content :global(th),
  .blog-content :global(td) {
    padding: 12px 16px;
    text-align: left;
    border-bottom: 1px solid var(--divider-color);
  }

  .blog-content :global(th) {
    background: rgba(255, 152, 0, 0.06);
    color: var(--primary-color);
    font-weight: 600;
  }

  .blog-card {
    display: flex;
    flex-direction: column;
    padding: 28px;
    background: var(--white-color);
    border-radius: 20px;
    border: 1px solid var(--divider-color);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
    text-decoration: none;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    height: 100%;
    margin-bottom: 30px;
  }

  .blog-card:hover {
    transform: translateY(-8px);
    border-color: var(--accent-color);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.12);
  }

  .blog-card-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 14px;
  }

  .blog-card-date {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: rgba(0, 0, 0, 0.45);
    font-weight: 500;
  }

  .blog-card-title {
    color: var(--primary-color);
    font-size: 18px;
    font-weight: 600;
    margin-bottom: 10px;
    line-height: 1.4;
    transition: color 0.3s ease;
  }

  .blog-card:hover .blog-card-title {
    color: var(--accent-color);
  }

  .blog-card-desc {
    color: var(--text-color);
    font-size: 14px;
    line-height: 1.7;
    margin-bottom: 16px;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .blog-card-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--accent-color);
    font-size: 14px;
    font-weight: 600;
    transition: gap 0.3s ease;
  }

  .blog-card-btn i {
    transition: transform 0.3s ease;
  }

  .blog-card:hover .blog-card-btn {
    gap: 12px;
  }

  .blog-card:hover .blog-card-btn i {
    transform: translateX(3px);
  }

  @media (max-width: 991px) {
    .blog-content {
      font-size: 16px;
      line-height: 1.7;
    }
    .blog-content :global(h1) { font-size: 28px; }
    .blog-content :global(h2) { font-size: 22px; }
    .blog-content :global(h3) { font-size: 19px; }
    .blog-hero-tag {
      font-size: 12px;
      padding: 5px 14px;
    }
  }

  @media (max-width: 575px) {
    .hero.hero-product h1,
    .hero.hero-product h2 {
      font-size: 28px;
    }

    .blog-content {
      font-size: 16px;
      line-height: 1.75;
    }
    .blog-content :global(h1) { font-size: 26px; margin-top: 30px; }
    .blog-content :global(h2) { font-size: 20px; margin-top: 28px; }
    .blog-content :global(h3) { font-size: 18px; margin-top: 24px; }
    .blog-content :global(table) {
      display: block;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }
    .blog-content :global(th),
    .blog-content :global(td) {
      padding: 10px 12px;
      font-size: 13px;
      min-width: 120px;
    }
    .blog-card {
      padding: 20px;
    }
    .blog-card-title {
      font-size: 16px;
    }
    .blog-card-desc {
      font-size: 15px;
      -webkit-line-clamp: 4;
    }
  }
</style>

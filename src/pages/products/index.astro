---
export const prerender = false;

import MainLayout from '../../layouts/MainLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import ProductCard from '../../components/ProductCard.astro';
import Pagination from '../../components/Pagination.astro';
import { getCollection } from 'astro:content';

const PRODUCTS_PER_PAGE = 6;

const url = new URL(Astro.request.url);
const q = url.searchParams.get('q') || '';
const category = url.searchParams.get('category') || '';
const pageParam = Number(url.searchParams.get('page') || '1');
const currentPage = Math.max(1, pageParam);
const hasFilter = q !== '' || category !== '';

const allProducts = await getCollection('products');
const sorted = allProducts
  .filter(p => p.data.created)
  .sort((a, b) => new Date(b.data.created).getTime() - new Date(a.data.created).getTime());

let filtered = sorted;
if (hasFilter) {
  filtered = sorted.filter(p => {
    const matchQ = !q || p.data.title.toLowerCase().includes(q.toLowerCase());
    const matchCat = !category || p.data.category === category;
    return matchQ && matchCat;
  });
}

const totalPages = Math.ceil(filtered.length / PRODUCTS_PER_PAGE);
const page = Math.min(currentPage, totalPages || 1);
const start = (page - 1) * PRODUCTS_PER_PAGE;
const pageProducts = filtered.slice(start, start + PRODUCTS_PER_PAGE);
const allCategories = [...new Set(allProducts.map(p => p.data.category))];

function buildHref(pageNum: number) {
  const params = new URLSearchParams();
  if (q) params.set('q', q);
  if (category) params.set('category', category);
  if (pageNum > 1) params.set('page', String(pageNum));
  const qs = params.toString();
  return qs ? `/products/?${qs}` : '/products/';
}

function buildFilterHref(cat: string, preserveSearch = true) {
  const params = new URLSearchParams();
  if (preserveSearch && q) params.set('q', q);
  if (cat !== 'all') params.set('category', cat);
  const qs = params.toString();
  return qs ? `/products/?${qs}` : '/products/';
}

function buildClearSearchHref() {
  const params = new URLSearchParams();
  if (category) params.set('category', category);
  const qs = params.toString();
  return qs ? `/products/?${qs}` : '/products/';
}

const searchParamsStr = url.searchParams.toString();
---

<MainLayout title={hasFilter ? `Products - Search Results` : 'Products'}>
  <Navbar />

  <!-- Hero Section -->
  <section class="hero hero-product bg-section dark-section" style="background-image: url(/images/hero-bg-image-6.webp); background-size: cover; background-position: center; background-repeat: no-repeat;">
    <div class="container">
      <div class="row">
        <div class="col-lg-12">
          <div class="section-title section-title-center">
            <h2 class="text-anime-style-3" data-cursor="-opaque">Our Products & Solutions</h2>
            <p class="wow fadeInUp" data-wow-delay="0.2s" style="margin-top: 10px; color: rgba(255,255,255,0.8); font-size: 1em;">
              Discover our range of IoT products designed for security, monitoring, and smart automation.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- All Products Section -->
  <section class="key-features bg-section">
    <div class="container">
      <div class="row section-row">
        <div class="col-lg-12">
          <div class="section-title section-title-center">
            <h3 class="wow fadeInUp">All Products</h3>
            <h2 class="text-anime-style-3" data-cursor="-opaque">
              Complete IoT ecosystem for your business needs
            </h2>
          </div>
        </div>
      </div>

      <!-- Search & Filter Bar -->
      <div class="products-toolbar wow fadeInUp" data-wow-delay="0.1s">
        <div class="products-search-wrap">
          <form method="GET" action="/products/" class="products-search">
            <svg class="search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input type="text" name="q" value={q} placeholder="Search for products..." autocomplete="off" />
            {category && <input type="hidden" name="category" value={category} />}
            {page > 1 && <input type="hidden" name="page" value="1" />}
            <button type="submit" class="search-submit-btn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
            </button>
            {q && (
              <a href={buildClearSearchHref()} class="search-clear-btn">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="18" y1="6" x2="6" y2="18"></line>
                  <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
              </a>
            )}
          </form>
        </div>
        <div class="products-filters-wrap">
          <div class="products-filters-wrap-inner" id="filtersWrap">
            <div class="products-filters" id="productFilters">
              <a href={buildFilterHref('all')} class:list={["filter-pill", { active: !category }]}>
                <span class="pill-dot"></span>
                All Products
              </a>
              {allCategories.map((cat, i) => (
                <a
                  href={buildFilterHref(cat)}
                  class:list={["filter-pill", { active: category === cat }]}
                  data-index={i}
                >
                  <span class="pill-dot"></span>
                  {cat}
                </a>
              ))}
              {allCategories.length > 4 && (
                <button class="see-all-btn" id="seeAllBtn" type="button">
                  <span class="see-all-text">Lainnya</span>
                  <span class="see-all-count">+{allCategories.length - 3}</span>
                  <svg class="see-all-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                </button>
              )}
            </div>
          </div>
          <span class="products-count">
            {hasFilter
              ? `${filtered.length} product${filtered.length !== 1 ? 's' : ''} found`
              : `${allProducts.length} products`}
          </span>
        </div>
      </div>

      <!-- Products Grid -->
      <div class="products-grid">
        {pageProducts.map((product) => (
          <ProductCard
            title={product.data.title}
            description={product.data.description}
            category={product.data.category}
            image={product.data.image?.src || '/images/hero.jpg'}
            href={`/products/${product.id}`}
          />
        ))}
      </div>

      {pageProducts.length === 0 && (
        <div class="no-results">
          <p>No products found. <a href="/products/">View all products</a></p>
        </div>
      )}

      <!-- Pagination -->
      {totalPages > 1 && (
        <Pagination
          currentPage={page}
          totalPages={totalPages}
          basePath="/products/"
          searchParams={searchParamsStr}
        />
      )}
    </div>
  </section>

  <!-- CTA Section -->
  <section class="cta-section bg-section dark-section">
    <div class="container">
      <div class="row">
        <div class="col-lg-12">
          <div class="cta-box wow fadeInUp">
            <div class="cta-content">
              <h2>Ready to Deploy IoT Solutions?</h2>
              <p>Get in touch with our team to discuss your specific requirements and find the right solution for your business.</p>
              <a href="/contact" class="btn-default btn-highlighted">Request a Demo</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</MainLayout>

<script>
  (function() {
    var btn = document.getElementById('seeAllBtn');
    var filters = document.getElementById('productFilters');
    if (!btn || !filters) return;

    var pills = Array.from(filters.querySelectorAll('.filter-pill'));
    var SHOW_LIMIT = 4;

    function collapsePills() {
      pills.forEach(function(pill, i) {
        pill.style.display = i < SHOW_LIMIT ? '' : 'none';
      });
      btn.querySelector('.see-all-text').textContent = 'Lainnya';
      btn.classList.remove('expanded');
      filters.classList.remove('expanded');
    }

    function expandPills() {
      pills.forEach(function(pill) {
        pill.style.display = '';
      });
      btn.querySelector('.see-all-text').textContent = 'Tutup';
      btn.classList.add('expanded');
      filters.classList.add('expanded');
    }

    if (pills.length > SHOW_LIMIT) {
      collapsePills();
      btn.addEventListener('click', function() {
        if (filters.classList.contains('expanded')) {
          collapsePills();
        } else {
          expandPills();
        }
      });
    }
  })();
</script>

<style>
  .hero.hero-product {
    padding: 120px 0 50px;
    margin-top: 0;
    display: flex;
    align-items: center;
  }

  .hero.hero-product .container {
    margin-top: 40px;
  }

  .products-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
  }

  .products-toolbar {
    margin-bottom: 40px;
  }

  .products-search-wrap {
    max-width: 640px;
    margin: 0 auto 28px;
  }

  .products-search {
    position: relative;
    width: 100%;
    display: flex;
    align-items: center;
  }

  .search-icon {
    position: absolute;
    left: 20px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-color);
    opacity: 0.4;
    pointer-events: none;
  }

  .products-search input[type="text"] {
    width: 100%;
    padding: 16px 50px 16px 54px;
    background: var(--white-color);
    border: 2px solid var(--divider-color);
    border-radius: 16px;
    font-size: 16px;
    font-weight: 500;
    color: var(--primary-color);
    outline: none;
    transition: all 0.3s ease;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.04);
  }

  .products-search input[type="text"]::placeholder {
    color: var(--text-color);
    opacity: 0.45;
    font-weight: 400;
  }

  .products-search input[type="text"]:focus {
    border-color: var(--accent-color);
    box-shadow: 0 0 0 4px rgba(255, 152, 0, 0.1), 0 4px 20px rgba(0, 0, 0, 0.06);
  }

  .search-submit-btn {
    position: absolute;
    right: 16px;
    top: 50%;
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--primary-color);
    border: none;
    border-radius: 50%;
    cursor: pointer;
    color: var(--white-color);
    transition: all 0.2s ease;
    text-decoration: none;
  }

  .search-submit-btn:hover {
    background: var(--accent-color);
  }

  .search-clear-btn {
    position: absolute;
    right: 68px;
    top: 50%;
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--divider-color);
    border-radius: 50%;
    color: var(--text-color);
    transition: all 0.2s ease;
    text-decoration: none;
  }

  .search-clear-btn:hover {
    background: var(--accent-color);
    color: var(--primary-color);
  }

  .products-filters-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    flex-wrap: wrap;
  }

  .products-filters-wrap-inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
  }

  .products-filters {
    display: inline-flex;
    gap: 10px;
    flex-wrap: wrap;
    justify-content: center;
    transition: all 0.3s ease;
  }

  .products-filters.expanded {
    row-gap: 10px;
  }

  .see-all-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 10px 18px;
    background: transparent;
    border: 1.5px dashed var(--divider-color);
    border-radius: 100px;
    font-size: 13px;
    font-weight: 600;
    color: var(--text-color);
    opacity: 0.6;
    cursor: pointer;
    transition: all 0.3s ease;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .see-all-btn:hover {
    opacity: 1;
    border-color: var(--accent-color);
    color: var(--accent-color);
  }

  .see-all-count {
    background: var(--divider-color);
    color: var(--text-color);
    padding: 1px 7px;
    border-radius: 100px;
    font-size: 11px;
    font-weight: 700;
  }

  .see-all-btn:hover .see-all-count {
    background: var(--accent-color);
    color: var(--primary-color);
  }

  .see-all-icon {
    transition: transform 0.3s ease;
  }

  .see-all-btn.expanded .see-all-icon {
    transform: rotate(180deg);
  }

  .products-count {
    font-size: 13px;
    color: var(--text-color);
    opacity: 0.6;
    font-weight: 500;
  }

  .filter-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 22px;
    background: var(--white-color);
    border: 1.5px solid var(--divider-color);
    border-radius: 100px;
    font-size: 14px;
    font-weight: 600;
    color: var(--text-color);
    cursor: pointer;
    transition: all 0.3s ease;
    white-space: nowrap;
    text-decoration: none;
  }

  .pill-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.35;
    transition: opacity 0.3s ease;
  }

  .filter-pill:hover {
    border-color: var(--accent-color);
    color: var(--accent-color);
  }

  .filter-pill:hover .pill-dot {
    opacity: 0.6;
  }

  .filter-pill.active {
    background: var(--primary-color);
    border-color: var(--primary-color);
    color: var(--white-color);
  }

  .filter-pill.active .pill-dot {
    background: var(--accent-color);
    opacity: 1;
  }

  .no-results {
    text-align: center;
    padding: 60px 0;
    color: var(--text-color);
    opacity: 0.6;
    font-size: 1.1em;
  }

  .no-results a {
    color: var(--accent-color);
    text-decoration: underline;
    font-weight: 600;
  }

  .cta-section {
    margin-bottom: 0;
  }

  @media (max-width: 991px) {
    .products-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    }
  }

  @media (max-width: 575px) {
    .hero.hero-product {
      padding: 70px 0 24px;
    }

    .hero.hero-product .container {
      margin-top: 16px;
    }

    .hero.hero-product h2 {
      font-size: 28px;
    }

    .hero.hero-product p {
      font-size: 0.95em;
      margin-top: 6px !important;
    }

    .products-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .products-search-wrap {
      margin-bottom: 20px;
    }

    .products-search input[type="text"] {
      padding: 13px 42px 13px 44px;
      font-size: 14px;
      border-radius: 12px;
    }

    .search-icon { left: 16px; }
    .search-submit-btn { right: 12px; width: 36px; height: 36px; }
    .search-clear-btn { right: 64px; width: 44px; height: 44px; }

    .products-filters {
      gap: 6px;
      flex-wrap: wrap;
      justify-content: flex-start;
    }

    .products-filters::-webkit-scrollbar { display: none; }

    .filter-pill {
      padding: 8px 16px;
      font-size: 12px;
    }

    .see-all-btn {
      padding: 8px 14px;
      font-size: 12px;
      display: inline-flex;
      align-items: center;
      flex-shrink: 0;
    }
  }
</style>

---
import { getCollection, render } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const products = await getCollection('products');

  return products.map((product) => ({
    params: {
      slug: product.id,
    },
    props: {
      product,
    },
  }));
}

const { product } = Astro.props;

const { Content } = await render(product);

const allProducts = await getCollection('products');
const relatedProducts = allProducts.filter(p => p.id !== product.id).slice(0, 3);

// Extract YouTube video ID from URL
function getYouTubeId(url: string) {
  const match = url.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/|youtube\.com\/embed\/)([^&\n?#]+)/);
  return match ? match[1] : null;
}

const videoId = product.data.video ? getYouTubeId(product.data.video) : null;

function imgSrc(img: any): string {
  if (!img) return '/images/hero.jpg';
  return typeof img === 'string' ? img : img?.src || '/images/hero.jpg';
}

const mainImage = imgSrc(product.data.image);
const galleryImages = product.data.gallery.map(imgSrc);
const allImages = [mainImage, ...galleryImages];
---

<MainLayout title={product.data.title}>
  <Navbar />

  <!-- Page Hero Section -->
  <section class="hero hero-product bg-section dark-section" style="background-image: url(/images/hero-bg-image-6.webp); background-size: cover; background-position: center; background-repeat: no-repeat;">
    <div class="container">
      <div class="row">
        <div class="col-lg-12">
          <div class="section-title section-title-center">
            <span class="product-category-badge wow fadeInUp">{product.data.category}</span>
            <h2 class="text-anime-style-3" data-cursor="-opaque">{product.data.title}</h2>
            <p class="wow fadeInUp" data-wow-delay="0.2s" style="margin-top: 10px; color: rgba(255,255,255,0.8); font-size: 1em;">
              {product.data.description}
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Product Detail Section -->
  <section class="key-features bg-section">
    <div class="container">
      <div class="row">
        <div class="col-lg-5">
          <div class="product-sidebar wow fadeInUp" data-wow-delay="0.2s">
            <!-- Image Gallery - Bank Mandiri Style -->
            <div class="product-gallery" id="productGallery" data-images={JSON.stringify(allImages)}>
              <div class="gallery-main-slider" id="galleryMainSlider">
                <div class="gallery-slides-container" id="gallerySlidesContainer">
                  {allImages.map((img, index) => (
                    <div class={`gallery-main-slide ${index === 0 ? 'active' : ''}`} data-index={index}>
                      <img class="slide-img" src={img} alt={`${product.data.title} - Image ${index + 1}`} draggable="false" oncontextmenu="return false;" />
                      <div class="slide-img-overlay" data-index={index}></div>
                    </div>
                  ))}
                </div>
                
                {product.data.gallery.length > 0 && (
                  <>
                    <button class="gallery-arrow gallery-arrow-left" id="galleryPrev" aria-label="Previous">
                      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="15 18 9 12 15 6"></polyline>
                      </svg>
                    </button>
                    <button class="gallery-arrow gallery-arrow-right" id="galleryNext" aria-label="Next">
                      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="9 18 15 12 9 6"></polyline>
                      </svg>
                    </button>
                  </>
                )}
                
                <div class="gallery-slide-counter" id="galleryCounter">
                  <span class="slide-current">1</span>
                  <span class="slide-divider">/</span>
                  <span class="slide-total">{product.data.gallery.length + 1}</span>
                </div>
              </div>
              
              {product.data.gallery.length > 0 && (
                <div class="gallery-thumb-slider" id="galleryThumbSlider">
                  <div class="thumb-slider-inner" id="thumbSliderInner">
                  {allImages.map((img, index) => (
                      <div class={`thumb-slide ${index === 0 ? 'active' : ''}`} data-index={index}>
                        <div class="thumb-bg" style={`background-image: url(${img})`}></div>
                      </div>
                    ))}
                  </div>
                </div>
              )}
            </div>

            {videoId && (
              <div class="product-video-section sidebar-video wow fadeInUp" data-wow-delay="0.1s">
                <h3 class="video-title">Product Video</h3>
                <div class="video-wrapper">
                  <iframe 
                    src={`https://www.youtube.com/embed/${videoId}`} 
                    title={product.data.title}
                    frameborder="0" 
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                    allowfullscreen
                    loading="lazy">
                  </iframe>
                </div>
              </div>
            )}
          </div>
        </div>

        <div class="col-lg-7">
          <div class="product-content-wrapper">
            <div class="product-content wow fadeInUp">
              <Content />
            </div>

            {videoId && (
              <div class="product-video-section content-video wow fadeInUp" data-wow-delay="0.1s">
                <h3 class="video-title">Product Video</h3>
                <div class="video-wrapper">
                  <iframe 
                    src={`https://www.youtube.com/embed/${videoId}`} 
                    title={product.data.title}
                    frameborder="0" 
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                    allowfullscreen
                    loading="lazy">
                  </iframe>
                </div>
              </div>
            )}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Related Products Section -->
  {relatedProducts.length > 0 && (
    <section class="why-choose-us bg-section">
      <div class="container">
        <div class="row section-row">
          <div class="col-lg-12">
            <div class="section-title section-title-center">
              <h3 class="wow fadeInUp">Related Products</h3>
              <h2 class="text-anime-style-3" data-cursor="-opaque">
                Explore more IoT solutions
              </h2>
            </div>
          </div>
        </div>

        <div class="row">
          {relatedProducts.map((relatedProduct, index) => (
            <div class="col-xl-4 col-md-6" key={relatedProduct.id}>
              <div class="related-product-card wow fadeInUp" data-wow-delay={`${index * 0.2}s`}>
                <a href={`/products/${relatedProduct.id}`} class="related-product-link">
                  <div class="related-product-image">
                    <img src={imgSrc(relatedProduct.data.image)} alt={relatedProduct.data.title} />
                    <span class="related-product-category">{relatedProduct.data.category}</span>
                  </div>
                  <div class="related-product-content">
                    <h3>{relatedProduct.data.title}</h3>
                    <p>{relatedProduct.data.description}</p>
                    <span class="related-product-btn">
                      View Details
                      <i class="fa-solid fa-arrow-right"></i>
                    </span>
                  </div>
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Image Lightbox Popup -->
  <div class="lightbox-overlay" id="lightboxOverlay">
    <div class="lightbox-backdrop" id="lightboxBackdrop"></div>
    <div class="lightbox-container" id="lightboxContainer">
      <button class="lightbox-close" id="lightboxClose" aria-label="Close">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
      <button class="lightbox-arrow lightbox-arrow-left" id="lightboxPrev" aria-label="Previous">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>
      <div class="lightbox-image-wrapper" id="lightboxImageWrapper">
        <img class="lightbox-image" id="lightboxImage" src="" alt="" draggable="false" />
      </div>
      <button class="lightbox-arrow lightbox-arrow-right" id="lightboxNext" aria-label="Next">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
      <div class="lightbox-counter" id="lightboxCounter">
        <span class="lightbox-current">1</span>
        <span class="lightbox-divider">/</span>
        <span class="lightbox-total">{product.data.gallery.length + 1}</span>
      </div>
      <div class="lightbox-thumbnails" id="lightboxThumbnails">
        {allImages.map((img, index) => (
          <div class={`lightbox-thumb ${index === 0 ? 'active' : ''}`} data-index={index}>
            <img src={img} alt="" loading="lazy" />
          </div>
        ))}
      </div>
    </div>
  </div>

  <Footer />
</MainLayout>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const slidesContainer = document.getElementById('gallerySlidesContainer');
    const slides = document.querySelectorAll('.gallery-main-slide');
    const thumbSlides = document.querySelectorAll('.thumb-slide');
    const thumbInner = document.getElementById('thumbSliderInner');
    const counter = document.getElementById('galleryCounter');
    const prevBtn = document.getElementById('galleryPrev');
    const nextBtn = document.getElementById('galleryNext');
    const total = slides.length;
    let current = 0;
    let autoPlayInterval;

    if (!slidesContainer || total === 0) return;

    // Block right-click & drag on gallery
    function blockDownload(e) {
      e.preventDefault();
      return false;
    }

    const productGallery = document.getElementById('productGallery');
    if (productGallery) {
      productGallery.addEventListener('contextmenu', blockDownload);
      productGallery.addEventListener('dragstart', blockDownload);
    }

    function goToSlide(index) {
      if (index < 0) index = total - 1;
      if (index >= total) index = 0;

      slides.forEach(s => s.classList.remove('active'));
      thumbSlides.forEach(t => t.classList.remove('active'));

      slides[index].classList.add('active');
      if (thumbSlides[index]) thumbSlides[index].classList.add('active');

      if (counter) {
        counter.querySelector('.slide-current').textContent = index + 1;
      }

      if (thumbInner && thumbSlides[index]) {
        const thumbEl = thumbSlides[index];
        const containerRect = thumbInner.getBoundingClientRect();
        const thumbRect = thumbEl.getBoundingClientRect();
        const scrollLeft = thumbEl.offsetLeft - containerRect.width / 2 + thumbRect.width / 2;
        thumbInner.scrollTo({ left: scrollLeft, behavior: 'smooth' });
      }

      current = index;
    }

    function nextSlide() {
      goToSlide(current + 1);
    }

    function prevSlide() {
      goToSlide(current - 1);
    }

    if (prevBtn) prevBtn.addEventListener('click', (e) => { e.stopPropagation(); prevSlide(); resetAutoPlay(); });
    if (nextBtn) nextBtn.addEventListener('click', (e) => { e.stopPropagation(); nextSlide(); resetAutoPlay(); });

    thumbSlides.forEach(thumb => {
      thumb.addEventListener('click', (e) => {
        e.stopPropagation();
        goToSlide(parseInt(thumb.dataset.index));
        resetAutoPlay();
      });
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') { prevSlide(); resetAutoPlay(); }
      if (e.key === 'ArrowRight') { nextSlide(); resetAutoPlay(); }
    });

    let startX = 0;
    let isDragging = false;

    slidesContainer.addEventListener('touchstart', (e) => {
      startX = e.touches[0].clientX;
      isDragging = true;
    }, { passive: true });

    slidesContainer.addEventListener('touchmove', (e) => {
      if (!isDragging) return;
    }, { passive: true });

    slidesContainer.addEventListener('touchend', (e) => {
      if (!isDragging) return;
      isDragging = false;
      const diff = startX - e.changedTouches[0].clientX;
      if (Math.abs(diff) > 50) {
        if (diff > 0) nextSlide();
        else prevSlide();
        resetAutoPlay();
      }
    });

    function startAutoPlay() {
      autoPlayInterval = setInterval(nextSlide, 5000);
    }

    function resetAutoPlay() {
      clearInterval(autoPlayInterval);
      startAutoPlay();
    }

    startAutoPlay();

    const galleryMain = document.getElementById('galleryMainSlider');
    if (galleryMain) {
      galleryMain.addEventListener('mouseenter', () => clearInterval(autoPlayInterval));
      galleryMain.addEventListener('mouseleave', startAutoPlay);
    }

    // === LIGHTBOX ===
    const allImages = productGallery ? JSON.parse(productGallery.dataset.images) : [];
    const lightboxOverlay = document.getElementById('lightboxOverlay');
    if (lightboxOverlay) {
      lightboxOverlay.addEventListener('contextmenu', blockDownload);
    }
    const lightboxBackdrop = document.getElementById('lightboxBackdrop');
    const lightboxContainer = document.getElementById('lightboxContainer');
    const lightboxImage = document.getElementById('lightboxImage');
    const lightboxClose = document.getElementById('lightboxClose');
    const lightboxPrevBtn = document.getElementById('lightboxPrev');
    const lightboxNextBtn = document.getElementById('lightboxNext');
    const lightboxCounter = document.getElementById('lightboxCounter');
    const lightboxThumbs = document.querySelectorAll('.lightbox-thumb');
    let lightboxCurrent = 0;
    let lightboxOpen = false;

    function openLightbox(index) {
      lightboxCurrent = index;
      updateLightboxImage();
      lightboxOverlay.classList.add('active');
      document.body.style.overflow = 'hidden';
      if (!lightboxOpen) {
        history.pushState({ lightbox: true }, '');
        lightboxOpen = true;
      }
    }

    function closeLightbox() {
      lightboxOverlay.classList.remove('active');
      document.body.style.overflow = '';
      lightboxOpen = false;
    }

    function updateLightboxImage() {
      lightboxImage.src = allImages[lightboxCurrent];
      lightboxImage.alt = `Image ${lightboxCurrent + 1}`;
      if (lightboxCounter) {
        lightboxCounter.querySelector('.lightbox-current').textContent = lightboxCurrent + 1;
      }
      lightboxThumbs.forEach((t, i) => {
        t.classList.toggle('active', i === lightboxCurrent);
      });
    }

    function lightboxNext() {
      lightboxCurrent = (lightboxCurrent + 1) % allImages.length;
      updateLightboxImage();
    }

    function lightboxPrev() {
      lightboxCurrent = (lightboxCurrent - 1 + allImages.length) % allImages.length;
      updateLightboxImage();
    }

    document.querySelectorAll('.slide-img-overlay').forEach(overlay => {
      overlay.addEventListener('click', () => openLightbox(current));
    });

    if (lightboxClose) lightboxClose.addEventListener('click', closeLightbox);
    if (lightboxBackdrop) lightboxBackdrop.addEventListener('click', closeLightbox);
    if (lightboxPrevBtn) lightboxPrevBtn.addEventListener('click', lightboxPrev);
    if (lightboxNextBtn) lightboxNextBtn.addEventListener('click', lightboxNext);

    lightboxThumbs.forEach(thumb => {
      thumb.addEventListener('click', () => {
        lightboxCurrent = parseInt(thumb.dataset.index);
        updateLightboxImage();
      });
    });

    document.addEventListener('keydown', (e) => {
      if (!lightboxOverlay.classList.contains('active')) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft') lightboxPrev();
      if (e.key === 'ArrowRight') lightboxNext();
    });

    let lightboxStartX = 0;
    let lightboxSwiping = false;

    const lightboxImageWrapper = document.getElementById('lightboxImageWrapper');
    if (lightboxImageWrapper) {
      lightboxImageWrapper.addEventListener('touchstart', (e) => {
        lightboxStartX = e.touches[0].clientX;
        lightboxSwiping = true;
      }, { passive: true });

      lightboxImageWrapper.addEventListener('touchmove', (e) => {
        if (!lightboxSwiping) return;
      }, { passive: true });

      lightboxImageWrapper.addEventListener('touchend', (e) => {
        if (!lightboxSwiping) return;
        lightboxSwiping = false;
        const diff = lightboxStartX - e.changedTouches[0].clientX;
        if (Math.abs(diff) > 50) {
          if (diff > 0) lightboxNext();
          else lightboxPrev();
        }
      });
    }

    if (lightboxContainer) {
      lightboxContainer.addEventListener('click', (e) => {
        if (e.target === lightboxContainer) closeLightbox();
      });
    }

    window.addEventListener('popstate', (e) => {
      if (lightboxOpen) {
        closeLightbox();
      }
    });
  });
</script>

<style>
  .hero.hero-product {
    padding: 120px 0 50px;
    margin-top: 0;
    display: flex;
    align-items: center;
  }

  .hero.hero-product .container {
    margin-top: 40px;
  }

  .product-category-badge {
    position: relative;
    display: inline-block;
    padding: 6px 14px;
    background: var(--dark-divider-color);
    backdrop-filter: blur(30px);
    -webkit-backdrop-filter: blur(30px);
    border-radius: 100px;
    font-size: 12px;
    font-weight: 600;
    color: var(--white-color);
    margin-bottom: 12px;
    padding-left: 30px;
  }
  
  .product-category-badge::before {
    content: '';
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    background: var(--accent-color);
    border-radius: 50%;
    width: 7px;
    height: 7px;
  }
  
  .product-content {
    background-color: var(--white-color);
    border-radius: 20px;
    padding: 50px;
  }
  
  .product-content :global(h1) {
    color: var(--primary-color);
    font-size: 36px;
    font-weight: 600;
    margin-bottom: 20px;
  }
  
  .product-content :global(h2) {
    color: var(--primary-color);
    font-size: 28px;
    font-weight: 600;
    margin-top: 40px;
    margin-bottom: 20px;
  }
  
  .product-content :global(h3) {
    color: var(--primary-color);
    font-size: 22px;
    font-weight: 600;
    margin-top: 30px;
    margin-bottom: 15px;
  }
  
  .product-content :global(p) {
    color: var(--text-color);
    line-height: 1.8;
    margin-bottom: 20px;
  }
  
  .product-content :global(ul) {
    color: var(--text-color);
    padding-left: 20px;
    margin-bottom: 25px;
  }
  
  .product-content :global(li) {
    margin-bottom: 12px;
    line-height: 1.7;
  }
  
  .product-content :global(strong) {
    color: var(--primary-color);
    font-weight: 600;
  }
  
  .product-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 25px 0;
  }
  
  .product-content :global(th),
  .product-content :global(td) {
    padding: 14px 18px;
    text-align: left;
    border-bottom: 1px solid var(--divider-color);
    color: var(--text-color);
  }
  
  .product-content :global(th) {
    color: var(--primary-color);
    font-weight: 600;
    background-color: var(--secondary-color);
  }

  /* Video Section */
  .product-video-section {
    margin-top: 40px;
  }

  .video-title {
    color: var(--primary-color);
    font-size: 22px;
    font-weight: 600;
    margin-bottom: 20px;
  }

  .video-wrapper {
    position: relative;
    padding-bottom: 56.25%;
    height: 0;
    overflow: hidden;
    border-radius: 16px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
  }

  .video-wrapper iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border-radius: 16px;
  }
  
  .product-sidebar {
    display: flex;
    flex-direction: column;
    gap: 30px;
  }
  
  .product-image-box {
    background-color: var(--white-color);
    border-radius: 20px;
    overflow: hidden;
  }
  
  .product-image-box img {
    width: 100%;
    height: auto;
    display: block;
  }
  
  .product-info-box,
  .product-cta-box {
    background-color: var(--white-color);
    border-radius: 20px;
    padding: 35px;
  }
  
  .product-info-box h3,
  .product-cta-box h3 {
    color: var(--primary-color);
    font-size: 22px;
    font-weight: 600;
    margin-bottom: 25px;
  }
  
  .product-info-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  
  .product-info-list li {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 0;
    border-bottom: 1px solid var(--divider-color);
  }
  
  .product-info-list li:last-child {
    border-bottom: none;
  }
  
  .info-label {
    color: var(--text-color);
  }
  
  .info-value {
    color: var(--primary-color);
    font-weight: 600;
  }
  
  .product-cta-box {
    background: var(--secondary-color);
  }
  
  .product-cta-box p {
    color: var(--text-color);
    margin-bottom: 25px;
  }
  
  .related-product-card {
    background: var(--white-color);
    border: 1px solid var(--divider-color);
    border-radius: 20px;
    overflow: hidden;
    transition: all 0.4s ease-in-out;
    height: 100%;
    margin-bottom: 30px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
  }
  
  .related-product-card:hover {
    transform: translateY(-10px);
    border-color: var(--accent-color);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.12);
  }
  
  .related-product-link {
    display: block;
    text-decoration: none;
  }
  
  .related-product-image {
    position: relative;
    height: 200px;
    overflow: hidden;
  }
  
  .related-product-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease-in-out;
  }
  
  .related-product-card:hover .related-product-image img {
    transform: scale(1.1);
  }
  
  .related-product-category {
    position: absolute;
    top: 16px;
    left: 16px;
    padding: 8px 16px;
    background: var(--accent-color);
    border-radius: 100px;
    font-size: 12px;
    font-weight: 600;
    color: var(--primary-color);
    text-transform: uppercase;
  }
  
  .related-product-content {
    padding: 24px;
  }
  
  .related-product-content h3 {
    color: var(--primary-color);
    font-size: 20px;
    font-weight: 600;
    margin-bottom: 12px;
    line-height: 1.3;
  }
  
  .related-product-content p {
    color: var(--text-color);
    font-size: 14px;
    line-height: 1.6;
    margin-bottom: 20px;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  .related-product-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--accent-color);
    font-size: 14px;
    font-weight: 600;
    transition: all 0.3s ease-in-out;
  }
  
  .related-product-btn i {
    transition: transform 0.3s ease-in-out;
  }
  
  .related-product-card:hover .related-product-btn i {
    transform: translateX(5px);
  }

  /* Video Toggle - Desktop vs Mobile */
  .content-video {
    display: none;
  }

  .sidebar-video {
    display: block;
  }

  .product-content-wrapper {
    display: flex;
    flex-direction: column;
    gap: 30px;
  }

  /* Product Gallery - Bank Mandiri Style */
  .product-gallery {
    background-color: #1a2332;
    border-radius: 16px;

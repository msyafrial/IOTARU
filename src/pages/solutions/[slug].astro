---
import { getCollection, render } from "astro:content";
import MainLayout from "../../layouts/MainLayout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";

export async function getStaticPaths() {
  const solutions = await getCollection("solutions");

  return solutions.map((solution) => ({
    params: {
      slug: solution.id,
    },
    props: {
      solution,
    },
  }));
}

const { solution } = Astro.props;
const { Content } = await render(solution);

const allSolutions = await getCollection("solutions");
const relatedSolutions = allSolutions
  .filter((s) => s.id !== solution.id)
  .slice(0, 2);
---

<MainLayout title={solution.data.title}>
  <Navbar />

  <!-- Hero Section -->
  <section
    class="hero hero-product bg-section dark-section"
    style="background-image: url(/images/hero-bg-image-6.webp); background-size: cover; background-position: center; background-repeat: no-repeat;"
  >
    <div class="container">
      <div class="row">
        <div class="col-lg-12">
          <div class="section-title section-title-center">
            <h2 class="text-anime-style-3" data-cursor="-opaque">
              {solution.data.title}
            </h2>
            <p
              class="wow fadeInUp"
              data-wow-delay="0.2s"
              style="margin-top: 10px; color: rgba(255,255,255,0.8); font-size: 1em;"
            >
              {solution.data.description}
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Solution Detail -->
  <section class="key-features bg-section">
    <div class="container">
      <div class="row">
        <div class="col-lg-8 mx-auto">
          <div class="solution-content wow fadeInUp" data-wow-delay="0.2s">
            <Content />
          </div>
        </div>
      </div>

      {
        relatedSolutions.length > 0 && (
          <div class="row section-row" style="margin-top: 60px;">
            <div class="col-lg-12">
              <div class="section-title section-title-center">
                <h3 class="wow fadeInUp">Other Solutions</h3>
                <h2 class="text-anime-style-3" data-cursor="-opaque">
                  Explore more of what we offer
                </h2>
              </div>
            </div>
          </div>
        )
      }

      {
        relatedSolutions.length > 0 && (
          <div class="row">
            {relatedSolutions.map((related, i) => (
              <div
                class="col-lg-6 wow fadeInUp"
                data-wow-delay={`${i * 0.15}s`}
              >
                <a href={`/solutions/${related.id}`} class="solution-card">
                  <h3 class="solution-card-title">{related.data.title}</h3>
                  <p class="solution-card-desc">{related.data.description}</p>
                  <span class="solution-card-btn">
                    Learn More
                    <i class="fa-solid fa-arrow-right" />
                  </span>
                </a>
              </div>
            ))}
          </div>
        )
      }
    </div>
  </section>

  <Footer />
</MainLayout>

<style>
  .solution-content {
    font-size: 16px;
    line-height: 1.8;
    color: var(--text-color);
  }

  .solution-content :global(h1) {
    color: var(--primary-color);
    font-size: 32px;
    font-weight: 700;
    margin-bottom: 16px;
    margin-top: 40px;
  }

  .solution-content :global(h2) {
    color: var(--primary-color);
    font-size: 24px;
    font-weight: 600;
    margin-top: 36px;
    margin-bottom: 14px;
  }

  .solution-content :global(h3) {
    color: var(--primary-color);
    font-size: 20px;
    font-weight: 600;
    margin-top: 28px;
    margin-bottom: 12px;
  }

  .solution-content :global(p) {
    margin-bottom: 16px;
    color: var(--text-color);
  }

  .solution-content :global(ul),
  .solution-content :global(ol) {
    margin-bottom: 20px;
    padding-left: 24px;
  }

  .solution-content :global(li) {
    margin-bottom: 8px;
    color: var(--text-color);
  }

  .solution-content :global(strong) {
    color: var(--primary-color);
    font-weight: 600;
  }

  .solution-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 24px;
    font-size: 14px;
  }

  .solution-content :global(th),
  .solution-content :global(td) {
    padding: 12px 16px;
    text-align: left;
    border-bottom: 1px solid var(--divider-color);
  }

  .solution-content :global(th) {
    background: rgba(255, 152, 0, 0.06);
    color: var(--primary-color);
    font-weight: 600;
  }

  .solution-card {
    display: flex;
    flex-direction: column;
    padding: 36px 28px;
    background: var(--white-color);
    border-radius: 20px;
    border: 1px solid var(--divider-color);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
    text-decoration: none;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    height: 100%;
    margin-bottom: 30px;
  }

  .solution-card:hover {
    transform: translateY(-8px);
    border-color: var(--accent-color);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.12);
  }

  .solution-card-title {
    color: var(--primary-color);
    font-size: 20px;
    font-weight: 600;
    margin-bottom: 12px;
    transition: color 0.3s ease;
  }

  .solution-card:hover .solution-card-title {
    color: var(--accent-color);
  }

  .solution-card-desc {
    color: var(--text-color);
    font-size: 14px;
    line-height: 1.7;
    margin-bottom: 20px;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .solution-card-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--accent-color);
    font-size: 14px;
    font-weight: 600;
    transition: gap 0.3s ease;
  }

  .solution-card-btn i {
    transition: transform 0.3s ease;
  }

  .solution-card:hover .solution-card-btn {
    gap: 12px;
  }

  .solution-card:hover .solution-card-btn i {
    transform: translateX(3px);
  }
</style>

</style>

<script>
  // Fokus pertama: field nama (progressive enhancement — tanpa JS form tetap berfungsi normal)
  if (!(window as any).__contactFormInit) {
    (window as any).__contactFormInit = true;
    window.addEventListener('load', () => {
      document.querySelector<HTMLInputElement>('#name')?.focus({ preventScroll: true });
    });
  }

  // Custom dropdown "Saya tertarik pada" — panel absolute di dalam .custom-select
  // (nempel 100% mulus saat scroll, tanpa JS reposition & tanpa getar/jitter).
  if (!(window as any).__contactSelectInit) {
    (window as any).__contactSelectInit = true;

    function initCustomSelect() {
      const wrap = document.getElementById('interestSelect');
      if (!wrap || (wrap as any).__selectReady) return;
      (wrap as any).__selectReady = true;

      const btn = wrap.querySelector<HTMLButtonElement>('.custom-select-btn');
      const iconWrap = wrap.querySelector<HTMLElement>('.custom-select-icon');
      const valueEl = wrap.querySelector<HTMLElement>('.custom-select-value');
      const hidden = wrap.querySelector<HTMLInputElement>('input[name="subject"]');
      const list = wrap.querySelector<HTMLUListElement>('.custom-select-list');
      if (!btn || !valueEl || !hidden || !list) return;

      let isOpen = false;

      const close = () => {
        isOpen = false;
        wrap.classList.remove('open');
        btn.setAttribute('aria-expanded', 'false');
        list.hidden = true;
        document.removeEventListener('click', onDocClick);
        document.removeEventListener('keydown', onKey);
      };

      const open = () => {
        isOpen = true;
        wrap.classList.add('open');
        btn.setAttribute('aria-expanded', 'true');
        list.hidden = false;
        document.addEventListener('click', onDocClick);
        document.addEventListener('keydown', onKey);
      };

      const onDocClick = (e: Event) => {
        const t = e.target as Node;
        if (!wrap.contains(t)) close();
      };

      const selectOption = (li: HTMLElement) => {
        const val = li.dataset.value || '';
        const iconClass =
          li.dataset.icon ||
          li.querySelector<HTMLElement>(':scope > i:first-child')?.className ||
          '';

        valueEl.textContent = val;
        hidden.value = val;

        // Update icon pada tombol select sesuai opsi yang dipilih
        if (iconWrap && iconClass) {
          iconWrap.classList.add('is-updating');
          const btnIcon = iconWrap.querySelector<HTMLElement>('i');
          if (btnIcon) {
            btnIcon.className = iconClass;
          } else {
            iconWrap.innerHTML = `<i class="${iconClass}"></i>`;
          }
          setTimeout(() => {
            iconWrap.classList.remove('is-updating');
          }, 150);
        }

        list.querySelectorAll('li').forEach((el) => {
          const sel = el === li;
          el.classList.toggle('is-selected', sel);
          el.setAttribute('aria-selected', String(sel));
        });
        close();
        btn.focus();
      };

      const onKey = (e: KeyboardEvent) => {
        if (e.key === 'Escape') {
          close();
          btn.focus();
          return;
        }
        if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
          e.preventDefault();
          const items = Array.from(list.querySelectorAll<HTMLElement>('li'));
          if (!items.length) return;
          const currentIndex = items.findIndex((el) => el === document.activeElement || el.classList.contains('is-selected'));
          let nextIndex = 0;
          if (e.key === 'ArrowDown') {
            nextIndex = currentIndex < items.length - 1 ? currentIndex + 1 : 0;
          } else {
            nextIndex = currentIndex > 0 ? currentIndex - 1 : items.length - 1;
          }
          items[nextIndex]?.focus();
        }
        if (e.key === 'Enter' || e.key === ' ') {
          const active = document.activeElement as HTMLElement | null;
          if (active && list.contains(active)) {
            const li = active.closest<HTMLElement>('li');
            if (li) {
              e.preventDefault();
              selectOption(li);
            }
          }
        }
      };

      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        if (isOpen) close();
        else open();
      });

      btn.addEventListener('keydown', (e) => {
        if ((e.key === 'ArrowDown' || e.key === 'ArrowUp') && !isOpen) {
          e.preventDefault();
          open();
          const selected = list.querySelector<HTMLElement>('li.is-selected') || list.querySelector<HTMLElement>('li');
          selected?.focus();
        }
      });

      list.addEventListener('click', (e) => {
        const li = (e.target as HTMLElement).closest('li');
        if (!li) return;
        selectOption(li);
      });

      wrap.addEventListener('astro:after-swap', () => {
        (wrap as any).__selectReady = false;
      });
    }

    if ((window as any).__iotaruPageLoadFired) initCustomSelect();
    else document.addEventListener('DOMContentLoaded', initCustomSelect, { once: true });
    document.addEventListener('astro:page-load', initCustomSelect);
  }

  // Validasi form modern: cegah submit bila kosong, tandai field invalid
  // dengan pesan inline per-field + banner alert glass. Fallback aman:
  // function.js (mailto) tetap jalan setelah validasi lolos.
  if (!(window as any).__contactValidateInit) {
    (window as any).__contactValidateInit = true;

    function initContactValidation() {
      const form = document.getElementById('contactForm') as HTMLFormElement | null;
      if (!form || (form as any).__validateReady) return;
      (form as any).__validateReady = true;

      const msg = document.getElementById('msgSubmit');
      const emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      let alertTimer: number | undefined;
      let currentAlert: HTMLElement | null = null;
      const name = form.querySelector<HTMLInputElement>('#name');
      const email = form.querySelector<HTMLInputElement>('#email');
      const message = form.querySelector<HTMLTextAreaElement>('#message');

      const clearAlertTimer = () => {
        if (alertTimer !== undefined) {
          window.clearTimeout(alertTimer);
          alertTimer = undefined;
        }
      };

      const dismissAlert = (el: HTMLElement) => {
        if (el.classList.contains('is-leaving')) return;
        el.classList.add('is-leaving');
        window.setTimeout(() => el.remove(), 260);
      };

      const hideErrorAlert = () => {
        if (currentAlert?.classList.contains('form-alert-error')) {
          clearAlertTimer();
          dismissAlert(currentAlert);
          currentAlert = null;
        }
      };

      const showAlert = (kind: 'success' | 'error', title: string, text: string) => {
        if (!msg) return;
        clearAlertTimer();
        msg.innerHTML = `
          <div class="form-alert form-alert-${kind}" role="${kind === 'error' ? 'alert' : 'status'}">
            <span class="alert-icon" aria-hidden="true"><i class="fa-solid ${kind === 'success' ? 'fa-circle-check' : 'fa-triangle-exclamation'}"></i></span>
            <div class="alert-body"><strong>${title}</strong><span>${text}</span></div>
            <button type="button" class="alert-close" aria-label="Tutup pemberitahuan"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
            ${kind === 'success' ? '<span class="alert-progress" aria-hidden="true"></span>' : ''}
          </div>`;
        const alert = msg.querySelector<HTMLElement>('.form-alert');
        currentAlert = alert;
        alert?.querySelector('.alert-close')?.addEventListener('click', () => {
          clearAlertTimer();
          if (alert) dismissAlert(alert);
          if (currentAlert === alert) currentAlert = null;
        });
        if (kind === 'success') {
          // Success auto-dismiss 6 detik (progress bar mengikuti)
          alertTimer = window.setTimeout(() => {
            if (alert) dismissAlert(alert);
            if (currentAlert === alert) currentAlert = null;
          }, 6000);
        }
      };

      // Tandai field invalid (border merah + shake) — TANPA teks di bawah
      // field; seluruh info error cukup lewat alert di bawah tombol.
      const setFieldError = (el: HTMLElement | null, invalid: boolean) => {
        if (!el) return;
        el.classList.toggle('is-invalid', invalid);
        if (invalid) {
          // Animasi shake sekali per penandaan (retrigger via reflow)
          el.classList.remove('shake');
          void (el as HTMLElement).offsetWidth;
          el.classList.add('shake');
          el.addEventListener('animationend', () => el.classList.remove('shake'), { once: true });
        }
      };

      const clearAllErrors = () => {
        form.querySelectorAll('.form-control.is-invalid').forEach((el) => el.classList.remove('is-invalid'));
      };

      // Validasi on-blur yang sopan: hanya menandai bila isi tidak valid,
      // atau field yang sudah ditandai dikosongkan kembali. Kosong yang
      // belum disentuh tidak langsung dihukum.
      const errorFor = (el: HTMLInputElement | HTMLTextAreaElement): string | null => {
        if (el === email) {
          if (!el.value.trim()) return 'Email wajib diisi';
          if (!emailRe.test(el.value.trim())) return 'Format email tidak valid';
        } else if (el === name) {
          if (!el.value.trim()) return 'Nama wajib diisi';
        } else if (el === message) {
          if (!el.value.trim()) return 'Pesan wajib diisi';
        }
        return null;
      };

      ([name, email, message] as Array<HTMLInputElement | HTMLTextAreaElement | null>).forEach((el) => {
        if (!el) return;
        el.addEventListener('blur', () => {
          const wasInvalid = el.classList.contains('is-invalid');
          const err = (el.value.trim() || wasInvalid) ? errorFor(el) : null;
          setFieldError(el, !!err);
          // Banner error hilang otomatis saat semua field kembali valid
          if (!form.querySelector('.is-invalid')) hideErrorAlert();
        });
      });

      form.addEventListener('submit', (e) => {
        if (!name || !email || !message) return;
        clearAllErrors();

        const errors: Array<[HTMLElement | null, string | null]> = [];
        let firstInvalid: HTMLElement | null = null;

        if (!name.value.trim()) {
          errors.push([name, 'Nama wajib diisi']);
        }
        if (!email.value.trim()) {
          errors.push([email, 'Email wajib diisi']);
        } else if (!emailRe.test(email.value.trim())) {
          errors.push([email, 'Format email tidak valid']);
        }
        if (!message.value.trim()) {
          errors.push([message, 'Pesan wajib diisi']);
        }

        if (errors.length) {
          e.stopImmediatePropagation(); // blokir handler mailto lama
          e.preventDefault();
          errors.forEach(([el]) => {
            if (el) setFieldError(el, true);
            if (el && !firstInvalid) firstInvalid = el;
          });
          // Ringkasan error hanya di alert bawah tombol (tanpa teks per-field)
          const summary = [...new Set(errors.map(([, t]) => t).filter(Boolean))].join(' · ');
          showAlert(
            'error',
            'Periksa kembali formulir Anda',
            summary
          );
          (firstInvalid as HTMLElement | null)?.focus();
          (firstInvalid as HTMLElement | null)?.scrollIntoView({ behavior: 'smooth', block: 'center' });
          return;
        }

        // Valid — blokir handler mailto lama (function.js membaca $("#subject")
        // padahal hidden input tidak punya id="subject" → TypeError, mailto tak
        // pernah jalan & alert tertimpa). Jalankan mailto di sini agar alert
        // profesional tetap tampil dan mailto benar-benar berfungsi.
        e.preventDefault();
        e.stopImmediatePropagation();
        const subjectVal = (form.querySelector<HTMLInputElement>('input[name="subject"]')?.value || '').trim();
        const mailtoLink =
          'mailto:syafrial@iotaru.com?subject=' +
          encodeURIComponent(subjectVal || 'Contact from ' + name.value.trim()) +
          '&body=' +
          encodeURIComponent(
            'Name: ' + name.value.trim() + '\nEmail: ' + email.value.trim() + '\n\n' + message.value.trim()
          );
        window.open(mailtoLink, '_blank');
        form.reset();
        // form.reset() tidak menyentuh teks label, icon & hidden value custom-select — kembalikan manual
        const selLabel = form.querySelector<HTMLElement>('.custom-select-value');
        if (selLabel) selLabel.textContent = 'Demo Produk';
        const selIcon = form.querySelector<HTMLElement>('.custom-select-icon i');
        if (selIcon) selIcon.className = 'fa-solid fa-display';
        const hiddenSubject = form.querySelector<HTMLInputElement>('input[name="subject"]');
        if (hiddenSubject) hiddenSubject.value = 'Demo Produk';
        const listItems = form.querySelectorAll<HTMLLIElement>('.custom-select-list li');
        listItems.forEach((li, idx) => {
          const isFirst = idx === 0;
          li.classList.toggle('is-selected', isFirst);
          li.setAttribute('aria-selected', String(isFirst));
        });
        showAlert('success', 'Membuka aplikasi email…', 'Tim kami akan menghubungi Anda dalam 1×24 jam kerja.');
      }, true); // capture: jalan sebelum handler jQuery lama
    }

    if ((window as any).__iotaruPageLoadFired) initContactValidation();
    else document.addEventListener('DOMContentLoaded', initContactValidation, { once: true });
    document.addEventListener('astro:page-load', initContactValidation);
  }
</script>

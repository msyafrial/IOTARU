---
import MainLayout from '../layouts/MainLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<MainLayout title="Page Not Found">
  <Navbar />

  <section class="hero bg-section dark-section" style="background-image: url(/images/hero-bg-image-6.webp); background-size: cover; background-position: center; background-repeat: no-repeat; min-height: 400px; display: flex; align-items: center;">
    <div class="container">
      <div class="row">
        <div class="col-lg-12">
          <div class="section-title section-title-center" style="padding-top: 120px;">
            <h2 class="text-anime-style-3" data-cursor="-opaque">404</h2>
            <p class="wow fadeInUp" data-wow-delay="0.2s" style="margin-top: 15px; color: rgba(255,255,255,0.8); font-size: 1.1em;">
              The page you're looking for doesn't exist or has been moved.
            </p>
            <div class="wow fadeInUp" data-wow-delay="0.4s" style="margin-top: 30px;">
              <a href="/" class="btn-default btn-highlighted">Back to Home</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</MainLayout>

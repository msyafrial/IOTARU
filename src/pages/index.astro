---
import MainLayout from "../layouts/MainLayout.astro";
import Preloader from "../components/Preloader.astro";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Features from "../components/Features.astro";
import Products from "../components/Products.astro";
import ProductCarousel from "../components/ProductCarousel.astro";
import WhatWeDo from "../components/WhatWeDo.astro";
import Technology from "../components/Technology.astro";
import HowItWorks from "../components/HowItWorks.astro";
import CTA from "../components/CTA.astro";
import FAQ from "../components/FAQ.astro";
import Footer from "../components/Footer.astro";
---

<MainLayout
  title="Home"
  description="IOTARU Teknologi Nusantara — Penyedia solusi IoT terpercaya, otomasi, SCADA, dan monitoring industri cerdas di Indonesia."
>
  <Preloader />
  <Navbar />
  <Hero />
  <ProductCarousel />
  <Technology />
  <About />
  <Features />
  <WhatWeDo />
  <HowItWorks />
  <CTA />
  <FAQ />
  <Footer />
</MainLayout>
<style>
@media only screen and (max-width: 1880px) {
    .bg-section {
        width: calc(100% - 40px);
    }
}
</style>
